# 部署模板：复制为 /etc/nginx/sites-available/anxin-hitsz.com，再软链到 sites-enabled/。
# 这是新增的 server 块，不要替换 QA-Agent 的 server 块。
#
# 证书由阿里云签发（DigiCert DV），SAN 覆盖 anxin-hitsz.com 与 www.anxin-hitsz.com，
# 所以两处 server_name 都带上 www。证书不符时先跑：
#   openssl x509 -in /etc/nginx/ssl/anxin-hitsz.com/anxin-hitsz.com.pem -noout -text | grep -A1 "Subject Alternative Name"

# HTTP 整站 301 到 HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name anxin-hitsz.com www.anxin-hitsz.com;
    return 301 https://$host$request_uri;
}

# HTTPS：静态站点 + /api 反代到 Go 服务
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name anxin-hitsz.com www.anxin-hitsz.com;

    ssl_certificate     /etc/nginx/ssl/anxin-hitsz.com/anxin-hitsz.com.pem;
    ssl_certificate_key /etc/nginx/ssl/anxin-hitsz.com/anxin-hitsz.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    root /var/www/anxin-site/dist;
    index index.html;

    # 三个体积上限里最外面的一层：Go 那边正文 JSON 限 2 MiB、单张图片限 4 MiB，
    # 这一条要同时盖住两者。nginx 的内置默认是 1 MB，不写这条，一张 1 MB 出头
    # 的截图会在这里被挡下。写 8m 而不是 4m，是因为图片那条线该由应用自己判——
    # 它的「图片不能超过 4 MB」比这里一句通用的话有用。
    client_max_body_size 8m;

    # 413 是唯一一个由 nginx 生成、前端却必须读懂的错误：默认那页 HTML 会被前端
    # 当成「传输失败」，说不清是图太大。这里换回和 Go 的 dto.ErrorResponse 一样的
    # 信封。只影响 nginx 自己生成的 413——Go 回的 413 原样透传，不会被这里改写
    # （proxy_intercept_errors 默认是关的）。
    error_page 413 = @tooLarge;
    location @tooLarge {
        default_type application/json;
        return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"请求体过大"}}';
    }

    # 不加这条，/api 会掉进 SPA 兜底并返回 index.html
    location = /api { return 404; }

    location ^~ /api/ {
        # 结尾不带 URI，原样透传 /api/v1/articles
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        # 必须大于前端的 requestTimeoutMs(8000)，否则先回 504 的是 nginx，
        # 页面显示的是网关错误而不是应用自己的错误态与重试按钮。
        proxy_read_timeout 15s;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
