# Copy to .env.local at repository root. Real API is the default.
VITE_DATA_SOURCE=http
VITE_API_BASE_URL=/api/v1
# Recommended: SSH tunnel to ECS Go service, see docs/deployment.md.
API_PROXY_TARGET=http://127.0.0.1:8080
# After domain HTTPS and Go are deployed, alternatively:
# API_PROXY_TARGET=https://anxin-hitsz.com
# UI-only development can set VITE_DATA_SOURCE=mock (never production).
