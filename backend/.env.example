# Configuration contract for your Go implementation; no loader is supplied.
# Keep the real file on ECS, outside the public frontend root.
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=personal_site_prod
MYSQL_USER=personal_site_app
MYSQL_PASSWORD=REPLACE_ON_ECS
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=UTC
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME_SECONDS=300
# 可选。同源请求不需要配——判断方式是拿 Origin 里的主机和本次请求的 Host 直接比，
# nginx 的 proxy_set_header Host $host 已经保留了它。只有反向代理改写了 Host
# 才需要在这里补，例如 Vite 开发代理：ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=
# 验证邮箱、重置口令的邮件正文里那个链接的前缀，末尾斜杠会被自动去掉。
# 生产必须填公开域名，否则信里的链接指向本机地址，点开是打不开的。
SITE_BASE_URL=https://anxin-hitsz.com
# 邮件通道。留空表示这台机器不发信：开发环境把验证链接打进日志，
# 生产环境则明确失败（注册和找回口令的信发不出去，只在日志里留一行）。
#
# 一旦填了 SMTP_HOST，下面四项就都成了必填——半套配置会在启动时直接报错，
# 而不是安静地不发信，让注册看着像成功。发件地址只填裸地址，不能带显示名。
#
# 465 是隐式 TLS。填其它端口则要求服务器支持 STARTTLS，不支持就拒绝发凭据。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Initial planning values; confirm against installed services and available RAM.
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=default
REDIS_PASSWORD=REPLACE_ON_ECS
REDIS_DB=0
REDIS_KEY_PREFIX=anxin:site:
ARTICLE_CACHE_ENABLED=false
ARTICLE_CACHE_TTL_SECONDS=60
